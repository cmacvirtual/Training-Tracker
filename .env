# Application/session
TOC_SECRET_KEY=replace-with-a-long-random-secret
TOC_SESSION_SECRET=replace-with-a-different-long-random-secret
TOC_FRONTEND_URL=http://localhost:3000
TOC_COOKIE_SECURE=false

# OIDC
TOC_OIDC_ENABLED=true
TOC_OIDC_PROVIDER_NAME=Company Account
TOC_OIDC_CLIENT_ID=replace-me
TOC_OIDC_CLIENT_SECRET=replace-me
TOC_OIDC_DISCOVERY_URL=https://YOUR-IDP/.well-known/openid-configuration
TOC_OIDC_ISSUER=https://YOUR-IDP/
TOC_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
TOC_OIDC_SCOPES=openid profile email
TOC_OIDC_LOGOUT_URL=

# Provisioning and roles
TOC_OIDC_AUTO_PROVISION=true
TOC_OIDC_DEFAULT_ROLE=instructor
TOC_OIDC_ADMIN_EMAILS=admin1@example.com,admin2@example.com
TOC_OIDC_ADMIN_GROUPS=Training-Admins
TOC_OIDC_INSTRUCTOR_GROUPS=Training-Instructors

# Temporary local fallback
TOC_LOCAL_LOGIN_ENABLED=true
TOC_RESET_DEFAULT_ADMIN=false
TOC_ENABLE_BOOTSTRAP_RESET=false
